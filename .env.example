# Titan Zero — canonical local/development bootstrap
# Company-owned operational state is resolved from canonical company_id through
# the Company Storage Resolver. A single DATABASE_URL below is only the local
# bootstrap/runtime database; it is not a shared multi-company business store.

# App
NODE_ENV=development
TITAN_DEPLOYMENT_PROFILE=local
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Canonical local storage
DATABASE_DIALECT=sqlite
DATABASE_URL=file:./data/titan-zero.db
SQLITE_PATH=./data/titan-zero.db
# Trusted operator root for physically isolated company databases. Runtime code
# must resolve opaque registered placements beneath this root; never derive a
# filesystem path directly from an untrusted company_id.
TITAN_COMPANY_DATA_ROOT=./data/companies

# Auth / node bootstrap
# REQUIRED at runtime: at least 32 characters. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=change_me_to_a_long_random_value_that_is_at_least_32_chars

# Optional production web identity/session composition. Keep unset until an
# operator has commissioned the existing GLOBAL_REGISTRY identity rows and
# supplied both independent signing secrets from the server secret manager.
# The public origin pins separate titan:web-login:<origin> and
# titan:web-session:<origin> issuer namespaces; request Host is never consulted.
# TITAN_WEB_PUBLIC_ORIGIN=https://field.example.com
# TITAN_WEB_IDENTITY_REGISTRY_PATH=/absolute/path/to/existing/global-registry.sqlite
# TITAN_WEB_LOGIN_KEY_ID=web-login-key-v1
# TITAN_WEB_LOGIN_SIGNING_SECRET=<base64url-encoded-secret-from-secret-manager>
# TITAN_WEB_SESSION_KEY_ID=web-session-key-v1
# TITAN_WEB_SESSION_SIGNING_SECRET=<different-base64url-secret-from-secret-manager>
# TITAN_WEB_IDENTITY_BINDINGS_JSON=[{"legacy_user_id":"<approved-user>","legacy_account_id":"<approved-account>","company_id":"<canonical-company>","actor_id":"<canonical-actor>","device_id":"<registered-device>"}]
# The registry must already have schema v1, an active actor/company/membership/
# device and a web-login external binding for each configured row. Web startup
# never migrates, creates, infers, or backfills these identity/access records.
# Cleaning-first login also reads the already-commissioned company placement
# registry in that same GLOBAL_REGISTRY file and opens existing stores beneath
# TITAN_COMPANY_DATA_ROOT. Login fails closed before setting the cookie if either
# setting is unavailable or the selected company's native placement is not READY.

# Secrets-at-rest bootstrap
# Node/platform wrapping material only. Company AI/email/payment/integration
# credentials belong behind company-scoped opaque credential_ref resolution.
# Generate when the currently enabled compatibility provider store requires it:
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Coordination / workers
REDIS_URL=redis://localhost:6379/0
WORKER_POLL_MS=30000

# Provider-neutral intelligence
# Titan must remain usable with no remote AI provider configured. Local models
# and company-owned/BYO providers are selected through the canonical provider /
# credential contracts. Do not place per-company API keys in this shared env.
#
# COMPATIBILITY ONLY for a deliberately node-wide legacy provider:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RECEIPT_PARSE_MODEL=claude-sonnet-4-6

# Email / communications
# Company-specific SMTP credentials belong behind canonical credential_ref
# resolution. Shared SMTP variables are compatibility-only and should be used
# only when the deployment explicitly configures one node-wide provider.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# SMS gateway settings are likewise legacy node-wide ingress. New company SMS
# credentials belong behind the company-scoped credential_ref provider boundary.
# SMS_GATEWAY_URL=
# SMS_GATEWAY_USERNAME=
# SMS_GATEWAY_PASSWORD=
# SMS_GATEWAY_SIM_NUMBER=

# Public booking compatibility
# Legacy BOOKING_ACCOUNT_ID is not the canonical company boundary. New flows
# resolve company_id through registered company/surface context. Keep only for
# migration/testing of a legacy public-booking deployment.
# BOOKING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Square / card-provider compatibility
# Provider configuration and secrets belong to company-scoped settings /
# credential references. This URL remains an optional legacy fallback only:
# SQUARE_WEBHOOK_URL=https://your-public-host/api/webhooks/square

# Optional object-storage compatibility
# Prefer company-scoped storage/provider configuration. Do not use shared
# credentials as an implicit multi-company secret model.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Web Push (optional). If unset, push is disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# Legacy shared-PostgreSQL development migration reference only:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=ai_fsm
# POSTGRES_USER=ai_fsm
# POSTGRES_PASSWORD=...
# DATABASE_URL=postgresql://...
