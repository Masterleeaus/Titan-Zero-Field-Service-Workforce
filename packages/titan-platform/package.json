{
  "name": "@titan-zero/titan-platform",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Standalone-safe Titan Zero runtime, workforce and intelligence capabilities migrated into Business Ops.",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./workforce": "./src/workforce.ts",
    "./intelligence": "./src/intelligence.ts",
    "./business-ops": "./src/business-ops.ts",
    "./business-evidence": "./src/business-evidence.ts",
    "./workforce-native": "./src/workforce-native/index.ts",
    "./workforce-delegation": "./src/workforce-delegation/index.ts",
    "./workforce-capacity": "./src/workforce-capacity/index.ts",
    "./interface-runtime": "./src/interface-runtime.ts",
    "./visual-runtime": "./src/visual-runtime.ts",
    "./titan-builder": "./src/titan-builder/index.ts",
    "./titan-connect": "./src/ported/titan-connect/connector-contract.ts",
    "./titan-connect/mcp": "./src/ported/titan-connect/mcp-host-contract.ts",
    "./titan-connect/credentials": "./src/ported/titan-connect/credential-contract.ts",
    "./ai-core/cost-sovereignty": "./src/ported/titan-ai-core/cost-sovereignty.ts",
    "./personal-zero": "./src/personal-zero/index.ts",
    "./interface-registry": "./src/interface-registry.ts",
    "./user-experience": "./src/user-experience.ts",
    "./system-configuration": "./src/system-configuration.ts",
    "./vertical-pack": "./src/vertical-pack.ts",
    "./communication-announcement": "./src/communication-announcement.ts",
    "./intelligence-core": "./src/intelligence-core.ts",
    "./surface-manager": "./src/surface-manager.ts",
    "./business-standards": "./src/business-standards.ts",
    "./distribution-gateway": "./src/distribution-gateway.ts",
    "./knowledge-governance": "./src/knowledge-governance.ts",
    "./mission-planning": "./src/mission-planning.ts",
    "./evidence-to-cash": "./src/evidence-to-cash.ts",
    "./reliability-policy": "./src/reliability-policy.ts",
    "./security-boundary": "./src/security-boundary.ts",
    "./quote-conversion": "./src/quote-conversion.ts",
    "./customer-care-recovery": "./src/customer-care-recovery.ts",
    "./growth-attribution": "./src/growth-attribution.ts",
    "./forecast-contract": "./src/forecast-contract.ts",
    "./connector-runtime": "./src/connector-runtime.ts",
    "./mcp-projection": "./src/mcp-projection.ts",
    "./workforce-coverage": "./src/workforce-coverage.ts",
    "./business-reality": "./src/business-reality.ts",
    "./constitution": "./src/constitution.ts",
    "./field-service-lifecycle": "./src/field-service-lifecycle.ts",
    "./directadmin-plugin": "./src/directadmin-plugin.ts"
  },
  "dependencies": {
    "@titan-zero/storage": "workspace:*",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json --noEmit false --outDir .test-dist --module NodeNext --moduleResolution NodeNext --isolatedModules false && node --test ./tests/*.test.mjs",
    "test:cleaning": "rm -rf .cleaning-test-dist && tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --rootDir src --outDir .cleaning-test-dist src/verticals/cleaning/*.ts && node --test ./tests/cleaning-vertical-pass*.test.mjs",
    "test:unit": "rm -rf .test-dist && tsc -p tsconfig.test.json --noEmit false --outDir .test-dist --module NodeNext --moduleResolution NodeNext --isolatedModules false && node --test ./tests/*.test.mjs",
    "test:workforce-native": "node scripts/test-workforce-native.mjs",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist --module NodeNext --moduleResolution NodeNext --isolatedModules false"
  }
}
