# Titan Zero — transitional runtime VPS environment
# Native Titan/AI-FSM is the default field-service product; Frappe is optional.
# The single SQLite path below is the current compatibility/runtime path and
# MUST NOT be interpreted as the target shared company business database.
# Target native operational persistence is one physical database per company,
# resolved from canonical company_id through a fail-closed storage mapping.
# The installer writes the runtime environment to:
# /opt/titan-zero/shared/env/.env
NODE_ENV=production
TITAN_DEPLOYMENT_PROFILE=vps
APP_TAG=latest
APP_PORT=3000
APP_DOMAIN=
APP_BASE_URL=http://YOUR_SERVER_IP
APP_URL=http://YOUR_SERVER_IP
NO_TLS=0
SECURE_COOKIES=true

DATABASE_DIALECT=sqlite
DATABASE_URL=file:/app/data/titan-zero.db
SQLITE_PATH=/app/data/titan-zero.db
# Target root for physically isolated native company databases. Current code
# must not derive arbitrary paths directly from untrusted company_id values.
TITAN_COMPANY_DATA_ROOT=/app/data/companies

REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY_LIMIT=384M
REDIS_CONTAINER_MEMORY_RESERVATION=128M

AUTH_SECRET=GENERATED_BY_INSTALLER
APP_ENCRYPTION_KEY=GENERATED_BY_INSTALLER

# COMPATIBILITY ONLY: legacy public-booking account selector. Canonical
# company/surface resolution must not depend on this variable.
# BOOKING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# COMPATIBILITY ONLY: shared provider credentials below must not become the
# multi-company production secret model. Company-specific AI/email/payment/
# connector credentials belong behind canonical company-scoped credential_ref
# resolution. Shared env is for node/platform bootstrap secrets only.
# Optional legacy node-wide AI provider credential. Do not use for per-company
# BYO/provider credentials; those resolve through company-scoped credential_ref.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional legacy node-wide shared email. Company-specific SMTP credentials must
# resolve through the canonical credential/provider boundary.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Optional legacy node-wide SMS gateway. New company SMS credentials resolve
# through the company-scoped credential/provider boundary.
# SMS_GATEWAY_URL=
# SMS_GATEWAY_USERNAME=
# SMS_GATEWAY_PASSWORD=
# SMS_GATEWAY_SIM_NUMBER=

# Optional push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

WORKER_POLL_MS=30000

# Workforce session verification commissioning. Replace the node/key identifiers
# with values from the trusted Titan/DirectAdmin issuers before installing. The
# referenced PEM files contain PUBLIC keys only; private issuer keys never go
# into this VPS env file. The installer prepares the company-store root but
# requires the canonical owners to commission the global identity/placement
# registry before install.
WORKFORCE_DIRECTADMIN_NODE_ID=REPLACE_WITH_DIRECTADMIN_NODE_ID
WORKFORCE_SESSION_ISSUER=REPLACE_WITH_TITAN_SESSION_ISSUER
WORKFORCE_SESSION_KEY_ID=REPLACE_WITH_TITAN_SESSION_KEY_ID
WORKFORCE_SESSION_ALGORITHM=EdDSA
WORKFORCE_UPSTREAM_SESSION_ISSUER=REPLACE_WITH_DIRECTADMIN_SESSION_ISSUER
WORKFORCE_UPSTREAM_SESSION_AUDIENCE=titan-workforce
WORKFORCE_UPSTREAM_SESSION_KEY_ID=REPLACE_WITH_DIRECTADMIN_SESSION_KEY_ID
WORKFORCE_UPSTREAM_SESSION_ALGORITHM=EdDSA
WORKFORCE_COMPANY_STORE_HOST_ROOT=/opt/titan-zero/shared/data/companies
WORKFORCE_IDENTITY_SQLITE_HOST_PATH=/opt/titan-zero/shared/data/runtime/identity.db
WORKFORCE_SESSION_PUBLIC_KEY_HOST_PATH=/opt/titan-zero/shared/keys/workforce-session.pub.pem
WORKFORCE_UPSTREAM_SESSION_PUBLIC_KEY_HOST_PATH=/opt/titan-zero/shared/keys/upstream-session.pub.pem

# Optional trusted module path for hosted DirectAdmin session/bootstrap
# services. It exports createWorkforceDirectAdminHostServices(); Workforce
# composes the canonical #1049 bridge and gateway. Configure only after #302
# protected provisioning and #1300's trusted cookie-boundary route are ready.
# When unset, /v1/directadmin/* remains disabled and returns 503.
# WORKFORCE_DIRECTADMIN_DEPENDENCIES_MODULE=/run/workforce/directadmin-host-services.mjs
