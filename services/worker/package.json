{
  "name": "@titan-zero/worker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@titan-zero/domain": "workspace:*",
    "@titan-zero/email-templates": "workspace:*",
    "@titan-zero/log": "workspace:*",
    "better-sqlite3": "^11.7.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "nodemailer": "~10.1.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "@types/nodemailer": "~6.4.17"
  }
}
